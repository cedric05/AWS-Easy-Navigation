{
  "manifest_version": 3,
  "name": "AWS Easy Navigation",
  "version": "1.0.0",
  "description": "Quick bookmarks for AWS console paths without relying on URLs with account-specific hostnames",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AWS Easy Navigation",
    "default_icon": {
      "16": "images/icon-16.svg",
      "48": "images/icon-48.svg",
      "128": "images/icon-128.svg"
    }
  },
  "icons": {
    "16": "images/icon-16.svg",
    "48": "images/icon-48.svg",
    "128": "images/icon-128.svg"
  }
}
